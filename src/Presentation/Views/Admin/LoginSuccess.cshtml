@{
    ViewData["Title"] = "Успішний вхід";
}

<div class="register-page">
    <div class="register-card" style="text-align: center;">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO | Admin</h1>
            <p class="brand-subtitle">Ви успішно увійшли до панелі керування</p>
        </div>

        <div class="welcome-actions">
            <a asp-action="Users" asp-controller="Admin" class="register-btn">Переглянути користувачів</a>
            <a href="/" class="register-btn ghost">Перейти на головну</a>
        </div>
    </div>
</div>

