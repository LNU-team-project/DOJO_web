@model DOJO2.Application.ViewModels.AdminLoginViewModel

@{
    ViewData["Title"] = "Вхід для адміністратора";
}

<div class="register-page">
    <div class="register-card">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO | Admin</h1>
            <p class="brand-subtitle">Вхід до панелі керування</p>
        </div>

        <form asp-action="Login" asp-controller="Admin" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="field-error" role="alert"></div>

            <div class="field">
                <label for="Login">Логін</label>
                <input id="Login" name="Login" class="form-field" placeholder="Введіть логін адміністратора" required />
                <span asp-validation-for="Login" class="field-error"></span>
            </div>

            <div class="field">
                <label for="Password">Пароль</label>
                <input id="Password" name="Password" type="password" class="form-field" placeholder="Введіть пароль" required />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <button class="register-btn" type="submit">Увійти</button>
        </form>

        <p class="register-footer">
            <a href="/Account/Register">Я не адміністратор</a>
        </p>
    </div>
</div>