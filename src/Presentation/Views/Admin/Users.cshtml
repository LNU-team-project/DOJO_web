@model DOJO2.Presentation.ViewModels.AdminUsersPageViewModel

@{
    ViewData["Title"] = "Користувачі";
}

<div class="register-page">
    <div class="register-card admin-users-card">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO | Admin</h1>
            <p class="brand-subtitle">Перегляд користувачів системи</p>
        </div>

        <form asp-action="Users" asp-controller="Admin" method="get" class="admin-users-search-form" novalidate>
            <div class="field admin-users-search-row">
                <label for="search">Пошук (email або username)</label>
                <input id="search"
                       name="search"
                       class="form-field"
                       value="@Model.Search"
                       placeholder="Наприклад: vlad або user@example.com" />
            </div>
            <div class="admin-users-actions">
                <button class="register-btn admin-users-search-btn" type="submit">Знайти</button>
                <a asp-action="Users" asp-controller="Admin" class="register-btn ghost admin-users-reset-btn">Скинути</a>
            </div>
        </form>

        <div class="admin-users-meta">
            Знайдено: <strong>@Model.Users.Count</strong>
        </div>

        @if (TempData["AdminUsersSuccessMessage"] is string successMessage)
        {
            <output class="admin-users-alert admin-users-alert-success">@successMessage</output>
        }

        @if (TempData["AdminUsersErrorMessage"] is string errorMessage)
        {
            <div class="admin-users-alert admin-users-alert-error" role="alert">@errorMessage</div>
        }

        @if (Model.Users.Count == 0)
        {
            <p class="register-footer">Користувачів за цим фільтром не знайдено.</p>
        }
        else
        {
            <div class="admin-users-table-wrap">
                <table class="admin-users-table" aria-label="Список користувачів">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Рівень</th>
                            <th>XP</th>
                            <th>Створено</th>
                            <th>Статус</th>
                            <th>Дія</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.Level</td>
                                <td>@user.ExpPoints</td>
                                <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <span class="admin-users-status admin-users-status-blocked">Заблоковано</span>
                                    }
                                    else
                                    {
                                        <span class="admin-users-status admin-users-status-active">Активний</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsBlocked)
                                    {
                                        <div class="admin-users-inline-form">
                                            <form asp-action="UnblockUser" asp-controller="Admin" method="post" class="admin-users-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <button type="submit" class="register-btn ghost admin-users-row-btn">Розблокувати</button>
                                            </form>

                                            <form asp-action="DeleteUser" asp-controller="Admin" method="post" class="admin-users-inline-form"
                                                  onsubmit="return confirm('Видалити користувача @user.UserName? Цю дію неможливо скасувати.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <button type="submit" class="register-btn admin-users-row-btn admin-users-row-btn-danger">Видалити</button>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="admin-users-inline-form">
                                            <form asp-action="BlockUser" asp-controller="Admin" method="post" class="admin-users-inline-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <button type="submit" class="register-btn admin-users-row-btn admin-users-row-btn-danger">Блокувати</button>
                                            </form>

                                            <form asp-action="DeleteUser" asp-controller="Admin" method="post" class="admin-users-inline-form"
                                                  onsubmit="return confirm('Видалити користувача @user.UserName? Цю дію неможливо скасувати.');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.Id" />
                                                <input type="hidden" name="search" value="@Model.Search" />
                                                <button type="submit" class="register-btn admin-users-row-btn admin-users-row-btn-danger">Видалити</button>
                                            </form>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="welcome-actions admin-users-footer-actions">
            <a asp-action="LoginSuccess" asp-controller="Admin" class="register-btn ghost">Назад</a>
            <a asp-action="Login" asp-controller="Admin" class="register-btn ghost">Вийти</a>
        </div>
    </div>
</div>
