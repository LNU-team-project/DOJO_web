@model DOJO2.Presentation.ViewModels.AdminUsersPageViewModel

@{
    ViewData["Title"] = "Користувачі";
}

<div class="register-page">
    <div class="register-card admin-users-card">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO | Admin</h1>
            <p class="brand-subtitle">Перегляд користувачів системи</p>
        </div>

        <form asp-action="Users" asp-controller="Admin" method="get" class="admin-users-search-form" novalidate>
            <div class="field admin-users-search-row">
                <label for="search">Пошук (email або username)</label>
                <input id="search"
                       name="search"
                       class="form-field"
                       value="@Model.Search"
                       placeholder="Наприклад: vlad або user@example.com" />
            </div>
            <div class="admin-users-actions">
                <button class="register-btn admin-users-search-btn" type="submit">Знайти</button>
                <a asp-action="Users" asp-controller="Admin" class="register-btn ghost admin-users-reset-btn">Скинути</a>
            </div>
        </form>

        <div class="admin-users-meta">
            Знайдено: <strong>@Model.Users.Count</strong>
        </div>

        @if (Model.Users.Count == 0)
        {
            <p class="register-footer">Користувачів за цим фільтром не знайдено.</p>
        }
        else
        {
            <div class="admin-users-table-wrap">
                <table class="admin-users-table" aria-label="Список користувачів">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Рівень</th>
                            <th>XP</th>
                            <th>Створено</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@user.Level</td>
                                <td>@user.ExpPoints</td>
                                <td>@user.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="welcome-actions admin-users-footer-actions">
            <a asp-action="LoginSuccess" asp-controller="Admin" class="register-btn ghost">Назад</a>
            <a asp-action="Login" asp-controller="Admin" class="register-btn ghost">Вийти</a>
        </div>
    </div>
</div>
