@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page"
     data-dashboard-root
     data-notifications-url="@Url.Content("~/api/notifications/dashboard")">
    <header class="dashboard-header" aria-label="Dashboard navigation">
        <h1 class="dashboard-title">Dashboard</h1>

        <fieldset class="dashboard-range-control">
            <legend class="visually-hidden">Date range selector</legend>
            <button type="button"
                    class="dashboard-arrow"
                    data-range-dir="prev"
                    aria-label="Попередній тиждень">
                &#9664;
            </button>

            <p class="dashboard-range-label" data-range-label aria-live="polite"></p>

            <button type="button"
                    class="dashboard-arrow"
                    data-range-dir="next"
                    aria-label="Наступний тиждень">
                &#9654;
            </button>
        </fieldset>

        <div class="dashboard-actions">
            <button type="button"
                    class="dashboard-todo-btn"
                    id="openTodoModal">
                Додати ціль
            </button>
            <button type="button"
                    class="dashboard-todo-btn dashboard-plan-btn"
                    id="openPlanModal">
                Додати план
            </button>
            <button type="button"
                    class="dashboard-todo-btn dashboard-schedule-btn"
                    id="openScheduleModal">
                Додати розклад
            </button>
            <button type="button"
                    class="dashboard-todo-btn dashboard-friends-btn"
                    id="openFriendsModal"
                    aria-haspopup="dialog"
                    aria-controls="friendsModal">
                Друзі
            </button>

            <button type="button"
                    class="dashboard-notification-btn"
                    id="openNotificationsModal"
                    aria-haspopup="dialog"
                    aria-controls="notificationsModal">
                <span class="dashboard-notification-icon" aria-hidden="true">🔔</span>
            </button>

            <button type="button" class="dashboard-leaderboard-btn" id="openLeaderboardBtn" aria-haspopup="dialog" aria-controls="leaderboardRoot">
                <span class="leaderboard-icon" aria-hidden="true">🏆</span>
            </button>

            <button type="button"
                    class="profile-avatar-btn"
                    id="openProfileModal"
                    aria-label="Відкрити профіль">
                <div class="profile-avatar-circle">
                    <img class="profile-avatar-img" id="profileAvatarImg" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff7a90'%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/%3E%3C/svg%3E" alt="Аватар профіля">
                </div>
                <div class="profile-username" id="profileUsername">Користувач</div>
            </button>
        </div>
    </header>

    <div class="dashboard-content">
        <div class="dashboard-main">
            <section class="dashboard-board" aria-label="Тижневий календар">
                <div class="dashboard-days" data-days-header></div>
                <div class="dashboard-time-grid" data-time-grid></div>
            </section>

            <div class="dashboard-lists-row" aria-label="Списки завдань і планів">
                <section class="todo-list-section" aria-label="Список TODO завдань">
                    <div class="todo-list-container">
                        <h2 class="todo-list-title">Завдання</h2>
                        <div class="todo-items" id="allTodoItems">
                            <p class="todo-empty-message">Немає завдань</p>
                        </div>
                    </div>
                </section>

                <section class="todo-list-section" aria-label="Список планів">
                    <div class="todo-list-container">
                        <h2 class="todo-list-title">Плани</h2>
                        <div class="todo-items" id="allPlanItems">
                            <p class="todo-empty-message">Немає планів</p>
                        </div>
                    </div>
                </section>
            </div>
        </div>

        <aside class="dashboard-sidebar" aria-label="Додаткові віджети">
            <div class="sidebar-card" data-mini-calendar>
                <div class="sidebar-card-header">
                    <span class="sidebar-card-icon" aria-hidden="true">📅</span>
                    <span class="sidebar-card-title">Календарі</span>
                </div>

                <div class="mini-calendar-header">
                    <button type="button" class="mini-cal-btn" data-cal-nav="prev" aria-label="Попередній місяць">&#9664;</button>
                    <div class="mini-cal-title" data-cal-title>Місяць</div>
                    <button type="button" class="mini-cal-btn" data-cal-nav="next" aria-label="Наступний місяць">&#9654;</button>
                </div>

                <div class="mini-calendar-weekdays" aria-hidden="true"></div>
                <div class="mini-calendar-grid" role="grid" aria-label="Календар місяця" data-cal-grid></div>
            </div>

            <div class="sidebar-card pomodoro-widget" data-pomodoro-root aria-label="Pomodoro таймер">
                <div class="pomodoro-card">
                    <p class="pomodoro-eyebrow">Focus station</p>
                    <h2 class="pomodoro-title">Pomodoro</h2>

                    <div class="pomodoro-mode" data-pomodoro-mode>Фокус</div>
                    <p class="pomodoro-time" data-pomodoro-time aria-live="polite">25:00</p>

                    <div class="pomodoro-controls">
                        <button type="button" class="pomodoro-btn pomodoro-btn-primary" data-pomodoro-start>
                            Старт
                        </button>
                        <button type="button" class="pomodoro-btn" data-pomodoro-pause>
                            Пауза
                        </button>
                        <button type="button" class="pomodoro-btn" data-pomodoro-reset>
                            Скинути
                        </button>
                        <button type="button" class="pomodoro-btn" data-pomodoro-skip>
                            Пропустити
                        </button>
                    </div>

                    <div class="pomodoro-presets-panel">
                        <label class="pomodoro-presets-label" for="pomodoroPresetSelect">Пресет</label>
                        <div class="pomodoro-presets-row">
                            <select id="pomodoroPresetSelect" class="pomodoro-preset-select" data-pomodoro-preset-select aria-label="Вибрати пресет Pomodoro"></select>
                            <button type="button" class="pomodoro-btn pomodoro-preset-add-btn" id="openPomodoroPresetModal">
                                Додати пресет
                            </button>
                        </div>
                    </div>

                    <div class="pomodoro-meta">
                        <p class="pomodoro-meta-row">
                            <span>Сесій сьогодні</span>
                            <strong data-pomodoro-count>0</strong>
                        </p>
                        <label class="pomodoro-auto">
                            <input type="checkbox" data-pomodoro-auto checked>
                            Автоматично запускати наступний раунд
                        </label>
                    </div>
                </div>
            </div>

            <div class="todo-modal pomodoro-preset-modal" id="pomodoroPresetModal" aria-hidden="true" aria-labelledby="pomodoroPresetModalTitle">
                <div class="todo-modal-content">
                    <div class="todo-modal-header">
                        <h2 id="pomodoroPresetModalTitle">Додати пресет</h2>
                        <button type="button" class="todo-modal-close" id="closePomodoroPresetModal" aria-label="Закрити вікно">×</button>
                    </div>

                    <form id="pomodoroPresetForm" class="todo-form" novalidate>
                        <div class="form-group">
                            <label for="pomodoroPresetName">Назва пресету</label>
                            <input type="text" id="pomodoroPresetName" class="form-control" maxlength="100" placeholder="Для навчання" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label for="pomodoroPresetFocus">Робота, хв</label>
                                <input type="number" id="pomodoroPresetFocus" class="form-control" min="1" max="180" value="25" />
                            </div>
                            <div class="form-group">
                                <label for="pomodoroPresetShortBreak">Короткий відпочинок, хв</label>
                                <input type="number" id="pomodoroPresetShortBreak" class="form-control" min="1" max="60" value="5" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="pomodoroPresetLongBreak">Довгий відпочинок, хв</label>
                            <input type="number" id="pomodoroPresetLongBreak" class="form-control" min="1" max="120" value="15" />
                        </div>

                        <p class="pomodoro-preset-error" data-pomodoro-preset-error aria-live="polite"></p>

                        <div class="todo-modal-footer" style="padding:0; justify-content:flex-end;">
                            <button type="submit" class="btn-primary">Зберегти пресет</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="sidebar-card statistics-widget" data-statistics-root aria-label="Статистика користувача">
                <div class="statistics-card">
                    <div class="statistics-header">
                        <div>
                            <p class="statistics-eyebrow">Твій прогрес</p>
                            <h2 class="statistics-title">Статистика</h2>
                        </div>
                    </div>

                    <div class="statistics-grid">
                        <div class="statistics-item">
                            <span class="statistics-label">Завдань виконано</span>
                            <span class="statistics-value" data-stat-completed-todos>0</span>
                        </div>
                        <div class="statistics-item">
                            <span class="statistics-label">Планів виконано</span>
                            <span class="statistics-value" data-stat-completed-plans>0</span>
                        </div>
                        <div class="statistics-item">
                            <span class="statistics-label">Помодоро сесій</span>
                            <span class="statistics-value accent" data-stat-pomodoro-sessions>0</span>
                        </div>
                        <div class="statistics-item">
                            <span class="statistics-label">Хвилин фокусу</span>
                            <span class="statistics-value" data-stat-pomodoro-minutes>0</span>
                        </div>
                    </div>

                    <button type="button" class="statistics-button" id="openStatisticsModal">
                        Переглянути детальніше
                    </button>
                </div>
            </div>

            <div class="sidebar-card sidebar-placeholder">
                <link rel="stylesheet" href="@Url.Content("~/css/hero-widget.css")" />

                <section class="hero-widget" aria-label="Твій герой">
                    <div class="hero-left">
                        <div class="hero-title">Твій герой</div>
                    </div>

                    <div class="hero-img" aria-hidden="true">
                        <img src="@Url.Content("~/images/piggy.svg")" alt="Свинка">
                    </div>

                    <div class="hero-center">
                        <div class="level-badge" id="heroLevel">Рівень 1</div>
                        <div class="hero-streak" aria-live="polite">
                            <span class="hero-streak-label">Поточна серія</span>
                            <strong class="hero-streak-value" id="heroStreakValue">0</strong>
                        </div>
                        <div class="exp-bar" aria-hidden="true">
                            <div class="exp-bar-inner" id="heroExpInner" style="width:0"></div>
                        </div>
                        <div class="exp-text" id="heroExpText">Потрібно 300 XP до наступного рівня</div>
                    </div>
                </section>
            </div>
        </aside>
    </div>
</div>

<div class="todo-modal" id="todoModal" aria-hidden="true" aria-labelledby="todoModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="todoModalTitle">Додати ціль</h2>
            <button type="button" class="todo-modal-close" id="closeTodoModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <form id="todoForm" class="todo-form">
            <div class="form-group">
                <label for="todoTitle">Назва завдання *</label>
                <input type="text"
                       id="todoTitle"
                       name="title"
                       class="form-control"
                       placeholder="Введіть назву завдання"
                       required
                       maxlength="255" />
            </div>

            <div class="form-group">
                <label for="todoDescription">Опис</label>
                <textarea id="todoDescription"
                          name="description"
                          class="form-control"
                          placeholder="Введіть опис завдання (необов'язково)"
                          rows="3"></textarea>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="1" class="priority-input">
                            <span class="priority-label priority-low">
                                <span class="priority-dot"></span>
                                Низька
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="2" class="priority-input" checked>
                            <span class="priority-label priority-medium">
                                <span class="priority-dot"></span>
                                Середня
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="3" class="priority-input">
                            <span class="priority-label priority-high">
                                <span class="priority-dot"></span>
                                Висока
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelTodoBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Додати TODO</button>
            </div>
        </form>
    </div>
</div>

<div class="todo-modal" id="planModal" aria-hidden="true" aria-labelledby="planModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="planModalTitle">Додати план</h2>
            <button type="button" class="todo-modal-close" id="closePlanModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <form id="planForm" class="todo-form">
            <div class="form-group">
                <label for="planTitle">Назва плану *</label>
                <input type="text"
                       id="planTitle"
                       name="title"
                       class="form-control"
                       placeholder="Введіть назву плану"
                       required
                       maxlength="255" />
            </div>

            <div class="form-group">
                <label for="planDescription">Опис</label>
                <textarea id="planDescription"
                          name="description"
                          class="form-control"
                          placeholder="Введіть опис плану (необов'язково)"
                          rows="3"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="planDate">Дата *</label>
                    <input type="date" id="planDate" name="planDate" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="planTime">Час *</label>
                    <input type="time" id="planTime" name="planTime" class="form-control" required />
                </div>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="1" class="priority-input">
                            <span class="priority-label priority-low">
                                <span class="priority-dot"></span>
                                Низька
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="2" class="priority-input" checked>
                            <span class="priority-label priority-medium">
                                <span class="priority-dot"></span>
                                Середня
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="3" class="priority-input">
                            <span class="priority-label priority-high">
                                <span class="priority-dot"></span>
                                Висока
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>

            <div class="form-group">
                <label for="planCreateAttachments">Файли (необов'язково)</label>
                <input type="file"
                       id="planCreateAttachments"
                       name="planCreateAttachments"
                       class="form-control"
                       multiple
                       accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.png,.jpg,.jpeg,.webp" />
            </div>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelPlanBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Додати план</button>
            </div>
        </form>
    </div>
</div>

<div class="todo-modal" id="scheduleModal" aria-hidden="true" aria-labelledby="scheduleModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="scheduleModalTitle">Додати розклад</h2>
            <button type="button" class="todo-modal-close" id="closeScheduleModal" aria-label="Закрити вікно">×</button>
        </div>

        <form id="scheduleForm" class="todo-form">
            <div class="form-group">
                <label for="scheduleTitle">Назва події *</label>
                <input type="text" id="scheduleTitle" name="title" class="form-control" required maxlength="255" placeholder="Введіть назву події" />
            </div>

            <div class="form-group">
                <label for="scheduleDescription">Опис</label>
                <textarea id="scheduleDescription" name="description" class="form-control" rows="3" placeholder="Введіть опис (необов'язково)"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="scheduleDate">Дата *</label>
                    <input type="date" id="scheduleDate" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="scheduleTime">Час *</label>
                    <input type="time" id="scheduleTime" class="form-control" required />
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="scheduleDuration">Тривалість (хв)</label>
                    <input type="number" id="scheduleDuration" class="form-control" min="5" max="720" value="60" />
                </div>
                <div class="form-group">
                    <label for="scheduleRecurrenceType">Повторення</label>
                    <select id="scheduleRecurrenceType" class="form-control">
                        <option value="none">Без повторення</option>
                        <option value="daily">Щодня</option>
                        <option value="weekly">Щотижня</option>
                        <option value="monthly">Щомісяця</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio">
                            <input type="radio" name="schedulePriority" value="1" class="priority-input">
                            <span class="priority-label priority-low">
                                <span class="priority-dot"></span>
                                Низька
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="schedulePriority" value="2" class="priority-input" checked>
                            <span class="priority-label priority-medium">
                                <span class="priority-dot"></span>
                                Середня
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="schedulePriority" value="3" class="priority-input">
                            <span class="priority-label priority-high">
                                <span class="priority-dot"></span>
                                Висока
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="scheduleRecurrenceInterval">Інтервал</label>
                    <input type="number" id="scheduleRecurrenceInterval" class="form-control" min="1" max="30" value="1" />
                </div>
                <div class="form-group">
                    <label for="scheduleRecurrenceEndDate">Повторювати до</label>
                    <input type="date" id="scheduleRecurrenceEndDate" class="form-control" />
                    <small class="form-help">Можна не вказувати, тоді подія буде повторюватися без кінцевої дати.</small>
                </div>
            </div>

            <fieldset class="form-group" id="scheduleWeeklyDaysGroup" style="display:none;">
                <legend>Дні тижня (для щотижневого повторення)</legend>
                <div class="schedule-weekday-options">
                    <label class="schedule-weekday-chip" for="scheduleDayMon"><input type="checkbox" id="scheduleDayMon" value="1"> Пн</label>
                    <label class="schedule-weekday-chip" for="scheduleDayTue"><input type="checkbox" id="scheduleDayTue" value="2"> Вт</label>
                    <label class="schedule-weekday-chip" for="scheduleDayWed"><input type="checkbox" id="scheduleDayWed" value="3"> Ср</label>
                    <label class="schedule-weekday-chip" for="scheduleDayThu"><input type="checkbox" id="scheduleDayThu" value="4"> Чт</label>
                    <label class="schedule-weekday-chip" for="scheduleDayFri"><input type="checkbox" id="scheduleDayFri" value="5"> Пт</label>
                    <label class="schedule-weekday-chip" for="scheduleDaySat"><input type="checkbox" id="scheduleDaySat" value="6"> Сб</label>
                    <label class="schedule-weekday-chip" for="scheduleDaySun"><input type="checkbox" id="scheduleDaySun" value="0"> Нд</label>
                </div>
            </fieldset>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelScheduleBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Додати розклад</button>
            </div>
        </form>
    </div>
</div>

<div class="todo-modal" id="scheduleDetailsModal" aria-hidden="true" aria-labelledby="scheduleDetailsModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="scheduleDetailsModalTitle">Перегляд розкладу</h2>
            <button type="button" class="todo-modal-close" id="closeScheduleDetailsModal" aria-label="Закрити вікно">×</button>
        </div>

        <div class="plan-details" id="scheduleDetailsView">
            <div class="plan-details-header">
                <div>
                    <h3 id="scheduleDetailTitle" class="plan-details-title">-</h3>
                    <div class="plan-details-meta">
                        <span id="scheduleDetailRecurrence" class="plan-status" style="color:var(--dojo-muted); font-weight:600;">-</span>
                    </div>
                </div>
                <div class="plan-details-meta">
                    <div id="scheduleDetailPriorityBadge" class="plan-priority-badge plan-priority-2">Середня</div>
                </div>
            </div>

            <div class="plan-details-card">
                <p id="scheduleDetailDescription" class="plan-details-desc">-</p>
                <div class="plan-details-meta-row" style="margin-top:12px;">
                    <span><strong>Дата та час:</strong>&nbsp;<span id="scheduleDetailDateTime">-</span></span>
                </div>
                <div class="plan-details-meta-row" style="margin-top:8px;">
                    <span><strong>Кінець повторення:</strong>&nbsp;<span id="scheduleDetailEndDate">Без обмежень</span></span>
                </div>
            </div>

            <div class="plan-details-actions">
                <button type="button" class="btn-secondary" id="closeScheduleDetailsBtn">Закрити</button>
                <button type="button" class="btn-secondary" id="deleteScheduleOccurrenceBtn">Видалити тільки цей раз</button>
                <button type="button" class="btn-primary" id="deleteScheduleFutureBtn">Видалити цей і всі наступні</button>
            </div>
        </div>
    </div>
</div>

<!-- Plan Details / Edit Modal -->
<div class="todo-modal" id="planDetailsModal" aria-hidden="true" aria-labelledby="planDetailsModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="planDetailsModalTitle">Перегляд плану</h2>
            <button type="button" class="todo-modal-close" id="closePlanDetailsModal" aria-label="Закрити вікно">×</button>
        </div>

        <!-- View mode -->
        <div id="planDetailsView" class="plan-details">
            <div class="plan-details-header">
                <div>
                    <h3 id="detailTitle" class="plan-details-title">-</h3>
                    <div class="plan-details-meta">
                        <span id="detailStatus" class="plan-status" style="color:var(--dojo-muted); font-weight:600;">-</span>
                    </div>
                </div>
                <div class="plan-details-meta">
                    <div id="detailPriorityBadge" class="plan-priority-badge plan-priority-2">Середня</div>
                </div>
            </div>

            <div class="plan-details-card">
                <p id="detailDescription" class="plan-details-desc">-</p>
                <div class="plan-details-meta-row" style="margin-top:12px;">
                    <span><strong>Дата та час:</strong>&nbsp;<span id="detailDateTime">-</span></span>
                </div>
                <div class="plan-details-meta-row" style="margin-top:8px;">
                    <span><strong>Підзадачі:</strong>&nbsp;<span id="detailSubTasksSummary">0</span></span>
                </div>
            </div>

            <div class="plan-details-card">
                <div class="plan-attachments-header">
                    <strong>Вкладення плану</strong>
                </div>
                <div class="plan-attachments-upload-row">
                    <input type="file" id="planAttachmentInput" class="hidden-file-input" />
                    <button type="button" class="btn-primary" id="uploadPlanAttachmentBtn">Прикріпити файл</button>
                </div>
                <div id="planAttachmentsList" class="plan-attachments-list"></div>
            </div>

            <div class="plan-details-actions">
                <button type="button" class="btn-secondary" id="closePlanDetailsBtn">Закрити</button>
                <button type="button" class="btn-primary" id="editPlanBtn">Редагувати</button>
            </div>
        </div>

        <!-- Edit mode -->
        <form id="planEditForm" class="todo-form" style="display:none;">
            <div class="form-group">
                <label for="editPlanTitle">Назва плану *</label>
                <input type="text" id="editPlanTitle" name="title" class="form-control" required maxlength="255" />
            </div>
            <div class="form-group">
                <label for="editPlanDescription">Опис</label>
                <textarea id="editPlanDescription" name="description" class="form-control" rows="3"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="editPlanDate">Дата *</label>
                    <input type="date" id="editPlanDate" name="planDate" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="editPlanTime">Час *</label>
                    <input type="time" id="editPlanTime" name="planTime" class="form-control" required />
                </div>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio"><input type="radio" name="editPlanPriority" value="1" class="priority-input"> <span class="priority-label priority-low"><span class="priority-dot"></span> Низька</span></label>
                        <label class="priority-radio"><input type="radio" name="editPlanPriority" value="2" class="priority-input"> <span class="priority-label priority-medium"><span class="priority-dot"></span> Середня</span></label>
                        <label class="priority-radio"><input type="radio" name="editPlanPriority" value="3" class="priority-input"> <span class="priority-label priority-high"><span class="priority-dot"></span> Висока</span></label>
                    </div>
                </fieldset>
            </div>

            <div class="plan-subtasks-editor">
                <label for="newPlanSubTaskTitle">Підзадачі</label>
                <div class="plan-subtask-create-row">
                    <input type="text"
                           id="newPlanSubTaskTitle"
                           class="form-control"
                           maxlength="255"
                           placeholder="Додайте нову підзадачу" />
                    <button type="button" class="btn-secondary" id="addPlanSubTaskBtn">Додати</button>
                </div>
                <div id="editPlanSubTasksList" class="plan-subtasks-list">
                    <p class="plan-subtasks-empty">Підзадач поки немає</p>
                </div>
            </div>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelEditPlanBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Зберегти зміни</button>
            </div>
        </form>
    </div>
</div>

