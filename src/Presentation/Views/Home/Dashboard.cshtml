@*
  Settings modal for profile
*@
<div class="profile-modal" id="profileSettingsModal" aria-hidden="true" aria-labelledby="profileSettingsModalTitle">
    <div class="profile-modal-overlay" id="profileSettingsModalOverlay"></div>
    <div class="profile-modal-content" style="min-height: 520px;">
        <div class="profile-modal-header">
            <h2 id="profileSettingsModalTitle">Налаштування профілю</h2>
            <button type="button" class="profile-modal-close" id="closeProfileSettingsModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <div class="profile-modal-body">
            <div class="profile-section" style="margin-bottom: 16px;">
                <div class="profile-avatar-section">
                    <img class="profile-modal-avatar" id="profileSettingsAvatar" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff7a90'%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/%3E%3C/svg%3E" alt="Аватар профіля">
                    <button type="button" class="profile-avatar-upload-btn" id="settingsAvatarUploadBtn">
                        Змінити аватар
                    </button>
                    <input type="file" id="settingsAvatarFileInput" class="hidden-file-input" accept=".jpg,.jpeg,.png,.webp">
                </div>
            </div>

            <div class="profile-section" style="gap: 10px;">
                <div class="profile-info" style="flex: 1;">
                    <div class="profile-info-item">
                        <label for="settingsUserName">Ім'я користувача</label>
                        <input type="text" id="settingsUserName" class="form-control" maxlength="256" placeholder="Введіть нове ім'я" readonly>
                    </div>
                </div>
                <div style="display:flex; flex-direction:row; gap:8px; align-items:flex-start;">
                    <button type="button" class="profile-btn profile-btn-settings" id="editUserNameBtn">
                        Змінити ім'я
                    </button>
                    <button type="button" class="profile-btn profile-btn-settings" id="saveUserNameBtn" style="display:none;">
                        Зберегти
                    </button>
                </div>
            </div>

            <div class="profile-section" style="margin-top: 8px;">
                <div class="profile-info" style="width:100%;">
                    <div class="profile-info-item" style="width:100%; display:flex; flex-direction:row; gap:12px; align-items:flex-start;">
                        <div style="flex:1; text-align:left;">
                            <label for="emailConfirmStatus">Email статус</label>
                            <p id="emailConfirmStatus" class="profile-value" style="margin:4px 0 0 0;">Непідтверджено</p>
                        </div>
                        <button type="button" class="profile-btn profile-btn-settings" id="sendEmailConfirmationBtn" style="white-space: nowrap;">
                            Підтвердити email
                        </button>
                    </div>
                </div>
            </div>

            <div class="profile-section" style="margin-top: 8px;">
                <div class="profile-info" style="width:100%;">
                    <div class="profile-info-item" style="width:100%;">
                        <label for="settingsResetPasswordBtn">Скинути пароль</label>
                        <button type="button" class="profile-btn profile-btn-settings" id="settingsResetPasswordBtn" style="width:100%;">
                            🔑 Скинути пароль
                        </button>
                    </div>
                </div>
            </div>

            <div class="profile-section" style="margin-top: 8px;">
                <div class="profile-info" style="width:100%;">
                    <div class="profile-info-item" style="width:100%;">
                        <label for="settingsDeleteAccountBtn">Небезпечна дія</label>
                        <button type="button" class="profile-btn profile-btn-logout" id="settingsDeleteAccountBtn" style="width:100%;">
                            🗑️ Видалити мій акаунт
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-modal-footer" style="flex-direction: column; gap: 10px; align-items: stretch;">
            <button type="button" class="profile-btn profile-btn-logout" id="closeProfileSettingsModalFooter">
                Закрити
            </button>
        </div>
    </div>
</div>

<!-- Statistics Modal -->
