@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-page" data-dashboard-root>
    <header class="dashboard-header" aria-label="Dashboard navigation">
        <h1 class="dashboard-title">Dashboard</h1>

        <fieldset class="dashboard-range-control">
            <legend class="visually-hidden">Date range selector</legend>
            <button type="button"
                    class="dashboard-arrow"
                    data-range-dir="prev"
                    aria-label="Попередній тиждень">
                &#9664;
            </button>

            <p class="dashboard-range-label" data-range-label aria-live="polite"></p>

            <button type="button"
                    class="dashboard-arrow"
                    data-range-dir="next"
                    aria-label="Наступний тиждень">
                &#9654;
            </button>
        </fieldset>

        <div class="dashboard-actions">
            <button type="button"
                    class="dashboard-todo-btn"
                    id="openTodoModal">
                Додати ціль
            </button>
            <button type="button"
                    class="dashboard-todo-btn dashboard-plan-btn"
                    id="openPlanModal">
                Додати план
            </button>

            <button type="button"
                    class="profile-avatar-btn"
                    id="openProfileModal"
                    aria-label="Відкрити профіль">
                <div class="profile-avatar-circle">
                    <img class="profile-avatar-img" id="profileAvatarImg" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff7a90'%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/%3E%3C/svg%3E" alt="Аватар профіля">
                </div>
                <div class="profile-username" id="profileUsername">Користувач</div>
            </button>
        </div>
    </header>

    <div class="dashboard-content">
        <section class="dashboard-board" aria-label="Тижневий календар">
            <div class="dashboard-days" data-days-header></div>
            <div class="dashboard-time-grid" data-time-grid></div>
        </section>

        <div class="dashboard-lists-row" aria-label="Списки завдань і планів">
            <section class="todo-list-section" aria-label="Список TODO завдань">
                <div class="todo-list-container">
                    <h2 class="todo-list-title">Завдання</h2>
                    <div class="todo-items" id="allTodoItems">
                        <p class="todo-empty-message">Немає завдань</p>
                    </div>
                </div>
            </section>

            <section class="todo-list-section" aria-label="Список планів">
                <div class="todo-list-container">
                    <h2 class="todo-list-title">Плани</h2>
                    <div class="todo-items" id="allPlanItems">
                        <p class="todo-empty-message">Немає планів</p>
                    </div>
                </div>
            </section>
        </div>
    </div>
</div>

<div class="todo-modal" id="todoModal" aria-hidden="true" aria-labelledby="todoModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="todoModalTitle">Додати ціль</h2>
            <button type="button" class="todo-modal-close" id="closeTodoModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <form id="todoForm" class="todo-form">
            <div class="form-group">
                <label for="todoTitle">Назва завдання *</label>
                <input type="text"
                       id="todoTitle"
                       name="title"
                       class="form-control"
                       placeholder="Введіть назву завдання"
                       required
                       maxlength="255" />
            </div>

            <div class="form-group">
                <label for="todoDescription">Опис</label>
                <textarea id="todoDescription"
                          name="description"
                          class="form-control"
                          placeholder="Введіть опис завдання (необов'язково)"
                          rows="3"></textarea>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="1" class="priority-input">
                            <span class="priority-label priority-low">
                                <span class="priority-dot"></span>
                                Низька
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="2" class="priority-input" checked>
                            <span class="priority-label priority-medium">
                                <span class="priority-dot"></span>
                                Середня
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="priority" value="3" class="priority-input">
                            <span class="priority-label priority-high">
                                <span class="priority-dot"></span>
                                Висока
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelTodoBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Додати TODO</button>
            </div>
        </form>
    </div>
</div>

<div class="todo-modal" id="planModal" aria-hidden="true" aria-labelledby="planModalTitle">
    <div class="todo-modal-content">
        <div class="todo-modal-header">
            <h2 id="planModalTitle">Додати план</h2>
            <button type="button" class="todo-modal-close" id="closePlanModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <form id="planForm" class="todo-form">
            <div class="form-group">
                <label for="planTitle">Назва плану *</label>
                <input type="text"
                       id="planTitle"
                       name="title"
                       class="form-control"
                       placeholder="Введіть назву плану"
                       required
                       maxlength="255" />
            </div>

            <div class="form-group">
                <label for="planDescription">Опис</label>
                <textarea id="planDescription"
                          name="description"
                          class="form-control"
                          placeholder="Введіть опис плану (необов'язково)"
                          rows="3"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="planDate">Дата *</label>
                    <input type="date" id="planDate" name="planDate" class="form-control" required />
                </div>
                <div class="form-group">
                    <label for="planTime">Час *</label>
                    <input type="time" id="planTime" name="planTime" class="form-control" required />
                </div>
            </div>

            <div class="form-row">
                <fieldset class="form-group">
                    <legend>Складність *</legend>
                    <div class="priority-options">
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="1" class="priority-input">
                            <span class="priority-label priority-low">
                                <span class="priority-dot"></span>
                                Низька
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="2" class="priority-input" checked>
                            <span class="priority-label priority-medium">
                                <span class="priority-dot"></span>
                                Середня
                            </span>
                        </label>
                        <label class="priority-radio">
                            <input type="radio" name="planPriority" value="3" class="priority-input">
                            <span class="priority-label priority-high">
                                <span class="priority-dot"></span>
                                Висока
                            </span>
                        </label>
                    </div>
                </fieldset>
            </div>

            <div class="todo-modal-footer">
                <button type="button" class="btn-secondary" id="cancelPlanBtn">Скасувати</button>
                <button type="submit" class="btn-primary">Додати план</button>
            </div>
        </form>
    </div>
</div>

<!-- Profile Modal -->
<div class="profile-modal" id="profileModal" aria-hidden="true" aria-labelledby="profileModalTitle">
    <div class="profile-modal-overlay" id="profileModalOverlay"></div>
    <div class="profile-modal-content">
        <div class="profile-modal-header">
            <h2 id="profileModalTitle">Мій профіль</h2>
            <button type="button" class="profile-modal-close" id="closeProfileModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <div class="profile-modal-body">
            <div class="profile-section">
                <div class="profile-avatar-section">
                    <img class="profile-modal-avatar" id="profileModalAvatar" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff7a90'%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/%3E%3C/svg%3E" alt="Аватар профіля">
                </div>

                <div class="profile-info">
                    <div class="profile-info-item">
                        <label>Ім'я користувача:</label>
                        <p id="profileDisplayUsername" class="profile-value">-</p>
                    </div>
                    <div class="profile-info-item">
                        <label>Пошта:</label>
                        <p id="profileDisplayEmail" class="profile-value">-</p>
                    </div>
                    <div class="profile-info-item">
                        <label>Рівень:</label>
                        <p id="profileDisplayLevel" class="profile-value">-</p>
                    </div>
                    <div class="profile-info-item">
                        <label>Очки досвіду:</label>
                        <p id="profileDisplayExpPoints" class="profile-value">-</p>
                    </div>
                    <div class="profile-info-item">
                        <label>Поточна серія:</label>
                        <p id="profileDisplayStreak" class="profile-value">-</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-modal-footer">
            <button type="button" class="profile-btn profile-btn-settings" id="profileSettingsBtn">
                ⚙️ Налаштування
            </button>
            <button type="button" class="profile-btn profile-btn-logout" id="profileLogoutBtn">
                Вихід
            </button>
        </div>
    </div>
</div>

@*
  Settings modal for profile
*@
<div class="profile-modal" id="profileSettingsModal" aria-hidden="true" aria-labelledby="profileSettingsModalTitle">
    <div class="profile-modal-overlay" id="profileSettingsModalOverlay"></div>
    <div class="profile-modal-content" style="min-height: 520px;">
        <div class="profile-modal-header">
            <h2 id="profileSettingsModalTitle">Налаштування профілю</h2>
            <button type="button" class="profile-modal-close" id="closeProfileSettingsModal" aria-label="Закрити вікно">
                ×
            </button>
        </div>

        <div class="profile-modal-body">
            <div class="profile-section" style="margin-bottom: 16px;">
                <div class="profile-avatar-section">
                    <img class="profile-modal-avatar" id="profileSettingsAvatar" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ff7a90'%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z'/%3E%3C/svg%3E" alt="Аватар профіля">
                    <button type="button" class="profile-avatar-upload-btn" id="settingsAvatarUploadBtn">
                        Змінити аватар
                    </button>
                    <input type="file" id="settingsAvatarFileInput" class="hidden-file-input" accept=".jpg,.jpeg,.png,.webp">
                </div>
            </div>

            <div class="profile-section" style="gap: 10px;">
                <div class="profile-info" style="flex: 1;">
                    <div class="profile-info-item">
                        <label for="settingsUserName">Ім'я користувача</label>
                        <input type="text" id="settingsUserName" class="form-control" maxlength="256" placeholder="Введіть нове ім'я" readonly>
                    </div>
                </div>
                <div style="display:flex; flex-direction:row; gap:8px; align-items:flex-start;">
                    <button type="button" class="profile-btn profile-btn-settings" id="editUserNameBtn">
                        Змінити ім'я
                    </button>
                    <button type="button" class="profile-btn profile-btn-settings" id="saveUserNameBtn" style="display:none;">
                        Зберегти
                    </button>
                </div>
            </div>

            <div class="profile-section" style="margin-top: 8px;">
                <div class="profile-info" style="width:100%;">
                    <div class="profile-info-item" style="width:100%; display:flex; flex-direction:row; gap:12px; align-items:flex-start;">
                        <div style="flex:1; text-align:left;">
                            <label>Email статус</label>
                            <p id="emailConfirmStatus" class="profile-value" style="margin:4px 0 0 0;">Непідтверджено</p>
                        </div>
                        <button type="button" class="profile-btn profile-btn-settings" id="sendEmailConfirmationBtn" style="white-space: nowrap;">
                            Підтвердити email
                        </button>
                    </div>
                </div>
            </div>

            <div class="profile-section" style="margin-top: 8px;">
                <div class="profile-info" style="width:100%;">
                    <div class="profile-info-item" style="width:100%;">
                        <label>Скинути пароль</label>
                        <button type="button" class="profile-btn profile-btn-settings" id="settingsResetPasswordBtn" style="width:100%;">
                            🔑 Скинути пароль
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="profile-modal-footer" style="flex-direction: column; gap: 10px; align-items: stretch;">
            <button type="button" class="profile-btn profile-btn-logout" id="closeProfileSettingsModalFooter">
                Закрити
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/todo.js" asp-append-version="true"></script>
    <script src="~/js/plan.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
}
