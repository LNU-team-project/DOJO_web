@model src.Presentation.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Скинути пароль";
}

<div class="register-page">
    <div class="register-card">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO</h1>
            <p class="brand-subtitle">Скиньте свій пароль.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Code" type="hidden" />
            <div class="field">
                <label asp-for="Email" for="Email">Пошта</label>
                <input asp-for="Email" id="Email" class="form-field" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Password" for="Password">Пароль</label>
                <input asp-for="Password" id="Password" class="form-field" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword" for="ConfirmPassword">Підтвердіть пароль</label>
                <input asp-for="ConfirmPassword" id="ConfirmPassword" class="form-field" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="register-btn">Скинути</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}