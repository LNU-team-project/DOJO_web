@model DOJO2.Application.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Забули пароль?";
}

<div class="register-page">
    <div class="register-card">
        <div class="register-brand">
            <div class="brand-mark" aria-hidden="true"></div>
            <h1 class="brand-title">DOJO</h1>
            <p class="brand-subtitle">Відновлення паролю</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="field">
                <label asp-for="Email" for="Email">Пошта</label>
                <input asp-for="Email" id="Email" class="form-field" placeholder="example@mail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="register-btn">Надіслати</button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}