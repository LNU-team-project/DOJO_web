@{
    ViewData["Title"] = "Налаштування повідомлень";
}

<div class="dashboard-page">
    <section class="dashboard-board" style="max-width: 760px; padding: 28px; margin-top: 24px;">
        <div style="display:flex; flex-direction:column; gap:14px;">
            <p class="notifications-modal-eyebrow" style="margin:0;">Налаштування сповіщень</p>
            <h1 class="dashboard-title" style="font-size: clamp(28px, 4vw, 34px);">Налаштування повідомлень</h1>
            <p style="margin:0; color:#5f4a54; line-height:1.6; max-width: 640px;">
                Тут ми згодом додамо керування каналами, типами та частотою сповіщень.
                Зараз це підготовча сторінка для подальшої реалізації.
            </p>

            <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:8px;">
                <a class="notifications-modal-settings-btn" href="@Url.Action("Dashboard", "Home")" style="text-decoration:none; display:inline-flex; align-items:center; justify-content:center;">
                    Повернутися на Dashboard
                </a>
            </div>
        </div>
    </section>
</div>

