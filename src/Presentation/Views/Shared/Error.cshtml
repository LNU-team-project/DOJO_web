@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var errorMessage = ViewData["ErrorMessage"] as string;
}

<h1 class="text-danger">Помилка.</h1>
<h2 class="text-danger">
    @(string.IsNullOrWhiteSpace(errorMessage)
        ? "Під час обробки запиту сталася помилка."
        : errorMessage)
</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p class="text-muted">Якщо проблема повторюється, спробуйте ще раз пізніше або поверніться на головну сторінку.</p>

<h3>Request details</h3>
<p>
    У режимі розробки можна побачити більше технічної інформації про помилку.
</p>