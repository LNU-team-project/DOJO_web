<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - DOJO</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/vendor.bundle.min.css"/>
    <link rel="stylesheet" href="~/css/site.bundle.min.css"/>
    <link rel="stylesheet" href="~/src.styles.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
<main role="main">
    @RenderBody()
</main>
<script src="~/js/vendor.bundle.min.js"></script>
<script src="~/js/site.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>