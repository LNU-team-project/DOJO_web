{
  "AdminUsers": {
    "MaxUsersForAdminPage": 1,
    "MinSearchLength": 2,
    "LockoutYears": 100
  },
  "AuthCookie": {
    "ExpireHours": 8,
    "BlockedNoticeMinutes": 5,
    "BlockedNoticeCookieName": "dojo_blocked_notice"
  },
  "EmailSender": {
    "FromAddress": "no-reply-staging@dojo.example",
    "FromName": "DOJO Staging"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "SendGrid": {
    "SendGridKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}

