{
  "AdminUsers": {
    "MaxUsersForAdminPage": 100,
    "MinSearchLength": 3,
    "LockoutYears": 100
  },
  "AuthCookie": {
    "ExpireHours": 8,
    "BlockedNoticeMinutes": 3,
    "BlockedNoticeCookieName": "dojo_blocked_notice"
  },
  "EmailSender": {
    "FromAddress": "no-reply@dojo.example",
    "FromName": "DOJO"
  },
  "Cache": {
    "LeaderboardSeconds": 300,
    "AdminUsersSeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning"
    }
  },
  "SendGrid": {
    "SendGridKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  }
}

